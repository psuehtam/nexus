[Unit]
Description=NEXUS local application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nexus
ExecStart=/usr/bin/bash /opt/nexus/linux/start.sh
ExecStop=/usr/bin/bash /opt/nexus/linux/stop.sh
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
